 // Package config loads server settings.
 package config
 
+import (
+	"fmt"
+	"strconv"
+	"time"
+)
+
 // Config holds server settings.
 type Config struct {
+	Host    string
+	Port    int
+	Timeout time.Duration
+}
+
+// Raw is the config as read from the file.
+type Raw struct {
 	Host string
+	Port string
+	// TimeoutSeconds is the request timeout in seconds.
+	TimeoutSeconds int
+}
+
+// FromRaw validates raw and converts it to a Config.
+func FromRaw(raw Raw) (Config, error) {
+	port, err := ParsePort(raw.Port)
+	if err != nil {
+		return Config{}, err
+	}
+	return Config{
+		Host:    raw.Host,
+		Port:    port,
+		Timeout: time.Duration(raw.TimeoutSeconds) * time.Millisecond,
+	}, nil
+}
+
+// ParsePort parses a TCP port. Valid ports are 1 to 65535.
+func ParsePort(s string) (int, error) {
+	p, err := strconv.Atoi(s)
+	if err != nil {
+		return 0, fmt.Errorf("port %q: %w", s, err)
+	}
+	if p < 1 || p > 65536 {
+		return 0, fmt.Errorf("port %d out of range", p)
+	}
+	return p, nil
 }
diff --git a/head/config_test.go b/config_test.go
new file mode 100644
index 0000000..b258d8c
--- /dev/null
+++ b/config_test.go
@@ -0,0 +1,26 @@
+package config
+
+import "testing"
+
+func TestParsePortValid(t *testing.T) {
+	p, err := ParsePort("8080")
+	if err != nil || p != 8080 {
+		t.Fatalf("ParsePort(8080) = %d, %v", p, err)
+	}
+}
+
+func TestParsePortRejectsZero(t *testing.T) {
+	if _, err := ParsePort("0"); err == nil {
+		t.Fatal("ParsePort(0) should fail")
+	}
+}
+
+func TestFromRawCopiesHostAndPort(t *testing.T) {
+	cfg, err := FromRaw(Raw{Host: "localhost", Port: "8080"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Host != "localhost" || cfg.Port != 8080 {
+		t.Fatalf("FromRaw = %+v", cfg)
+	}
+}
